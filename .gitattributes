# Auto detect text files and perform LF normalization
* text=auto

# Batch scripts MUST use CRLF line endings on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Java source files
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Web frontend
*.vue text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Python
*.py text eol=lf
*.txt text eol=lf

# Binary files
*.jar binary
*.zip binary
*.msi binary
*.png binary
*.jpg binary
